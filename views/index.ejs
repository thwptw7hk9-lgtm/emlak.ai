<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EmlakIQ PRO | Global Real Estate Intelligence</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root { --navy: #0F172A; --gold: #B48C48; --border: #E2E8F0; --bg: #FDFDFD; }
        body { font-family: 'Inter', sans-serif; background: var(--bg); margin: 0; color: var(--navy); display: flex; }
        
        /* Minimalist Sidebar */
        .sidebar { width: 70px; height: 100vh; background: var(--navy); position: fixed; transition: 0.3s ease; z-index: 1000; overflow: hidden; }
        .sidebar:hover { width: 260px; }
        .nav-link { padding: 20px 25px; display: flex; align-items: center; color: #94A3B8; text-decoration: none; border-left: 3px solid transparent; }
        .nav-link:hover { background: #1E293B; color: white; border-left-color: var(--gold); }
        .nav-link i { min-width: 30px; font-size: 18px; margin-right: 20px; }
        .nav-link span { opacity: 0; font-size: 13px; font-weight: 500; letter-spacing: 1px; transition: 0.2s; white-space: nowrap; }
        .sidebar:hover .nav-link span { opacity: 1; }

        /* Main Context */
        .main { margin-left: 70px; width: 100%; }
        .header { padding: 50px 60px 20px; display: flex; justify-content: space-between; align-items: flex-end; }
        .title { font-family: 'Playfair Display', serif; font-size: 36px; margin: 0; font-weight: 700; }
        
        /* Professional Filters */
        .filter-bar { margin: 20px 60px 40px; display: flex; gap: 15px; border-bottom: 1px solid var(--border); padding-bottom: 30px; }
        .f-select { border: 1px solid var(--border); padding: 10px 15px; border-radius: 2px; font-size: 12px; font-weight: 600; color: var(--navy); cursor: pointer; background: white; outline: none; }
        .f-select:hover { border-color: var(--gold); }

        /* Property Cards */
        .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(380px, 1fr)); gap: 40px; padding: 0 60px 60px; }
        .card { background: white; border: 1px solid var(--border); border-radius: 0; transition: 0.4s; cursor: pointer; }
        .card:hover { transform: translateY(-5px); box-shadow: 0 20px 40px rgba(0,0,0,0.05); }
        .card-img { width: 100%; height: 280px; object-fit: cover; }
        .card-body { padding: 25px; }
        .status-tag { font-size: 10px; font-weight: 700; color: var(--gold); letter-spacing: 2px; margin-bottom: 10px; display: block; }
        .card-title { font-size: 20px; font-weight: 500; margin: 10px 0; letter-spacing: -0.5px; }
        .card-price { font-size: 22px; font-weight: 400; color: var(--navy); margin-top: 15px; border-top: 1px solid #F1F5F9; padding-top: 15px; }

        .btn-cta { background: var(--navy); color: white; padding: 12px 25px; border-radius: 2px; text-decoration: none; font-size: 12px; font-weight: 600; letter-spacing: 1px; border: 1px solid var(--navy); transition: 0.3s; }
        .btn-cta:hover { background: transparent; color: var(--navy); }
    </style>
</head>
<body>

    <nav class="sidebar">
        <div style="padding: 25px; color: var(--gold); font-weight: 800; font-size: 22px;">IQ</div>
        <a href="/" class="nav-link"><i class="fas fa-layer-group"></i> <span>PORTFÖY</span></a>
        <a href="/ai-analyzer" class="nav-link"><i class="fas fa-microchip"></i> <span>ANALİZ MERKEZİ</span></a>
        <a href="/auth" class="nav-link"><i class="fas fa-lock"></i> <span>GÜVENLİ ERİŞİM</span></a>
    </nav>

    <div class="main">
        <div class="header">
            <div>
                <p style="color: var(--gold); font-size: 11px; font-weight: 700; letter-spacing: 3px; margin-bottom: 10px;">KURUMSAL GAYRİMENKUL ANALİZİ</p>
                <h1 class="title">Seçkin Portföy</h1>
            </div>
            <a href="#" class="btn-cta">VARLIK YÖNETİMİ</a>
        </div>

        <div class="filter-bar">
            <select class="f-select"><option>LOKASYON: TÜMÜ</option></select>
            <select class="f-select"><option>TİP: KONUT & TİCARİ</option></select>
            <select class="f-select"><option>DURUM: SATILIK</option></select>
        </div>

        <div class="grid">
            <% properties.forEach(p => { %>
                <div class="card" onclick="location.href='/property/<%= p.id %>'">
                    <img src="<%= p.img %>" class="card-img">
                    <div class="card-body">
                        <span class="status-tag">● STRATEJİK YATIRIM</span>
                        <h3 class="card-title"><%= p.title %></h3>
                        <p style="color: #64748B; font-size: 13px;"><%= p.city %>, TR</p>
                        <div class="card-price"><%= p.price %> ₺</div>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>

</body>
</html>